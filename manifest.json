{
   "action": {
      "default_icon": {
         "128": "assets/icon128.png",
         "16": "assets/icon16.png",
         "48": "assets/icon48.png"
      },
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background/background.js"
   },
   "commands": {
      "capture-area": {
         "description": "Capturar Área Selecionada",
         "suggested_key": {
            "default": "Ctrl+Shift+Y"
         }
      },
      "capture-visible": {
         "description": "Capturar Área Visível",
         "suggested_key": {
            "default": "Ctrl+Shift+H"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://api.qrserver.com https://4u.ia.br;"
   },
   "description": "Solução profissional de captura de tela, anotação, gravação e inteligência artificial para o ecossistema 4U.IA.BR.",
   "icons": {
      "128": "assets/icon128.png",
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "PrintScreen Editor & Capture",
   "permissions": [ "activeTab", "scripting", "storage", "unlimitedStorage", "tabs", "contextMenus", "notifications", "clipboardWrite" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.0"
}
